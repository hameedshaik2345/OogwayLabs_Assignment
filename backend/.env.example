# .env.example
# Copy this file to .env and fill in your values

# ----------------------------
# Database Configuration
# ----------------------------
# For local SQLite development (default):
# DATABASE_URL=sqlite:///./app.db
# For PostgreSQL (Docker / Supabase / Railway):
# DATABASE_URL=postgresql://user:password@localhost:5432/lenny_assistant

# ----------------------------
# LLM Provider Configuration
# ----------------------------
# Set the LLM provider ('local' for Ollama, 'cloud' for Anthropic)
LLM_PROVIDER=local

# Local Ollama Model Name (default is llama3)
LOCAL_MODEL=llama3

# Anthropic API Key (Required if LLM_PROVIDER=cloud)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
